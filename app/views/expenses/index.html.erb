<% content_for :title, "Expenses" %>
<%= render "shared/page_header",
      title: "Expenses",
      purpose: "Review spending for the selected month.",
      primary: link_to("Record an expense", quick_expense_path, class: "ui-button") %>
<% if @load_error %>
  <%= render "shared/load_error" %>
<% elsif @expenses.empty? && !@any_expenses %>
  <%= render "shared/empty_state", kind: "empty", title: "No expenses recorded yet", message: "Record a spending expense to see it in this month.", links: link_to("Record an expense", quick_expense_path, class: "ui-button") %>
<% elsif @expenses.empty? %>
  <%= render "shared/empty_state", kind: "filter", title: "Nothing matches this month", message: "No expenses match this month. Choose another month to see earlier spending." %>
<% else %>
  <div class="grid gap-4 md:grid-cols-2">
    <section id="month-total" class="ui-card md:col-span-2">
      <h2 class="ui-label uppercase tracking-wide"><%= @month.strftime("%B %Y") %></h2>
      <p class="text-2xl font-semibold"><%= money(@total) %></p>
      <%= link_to "Record an expense", quick_expense_path, class: "ui-button mt-3" %>
    </section>

    <section id="categories" class="ui-card">
      <h2 class="font-semibold">Categories</h2>
      <% if @categories.blank? %>
        <p class="mt-2 text-sm">Expenses in this month do not have category totals yet.</p>
      <% else %>
        <ul class="mt-3 grid gap-2">
          <% @categories.each do |name, amount| %>
            <li class="flex items-baseline justify-between gap-3">
              <span><%= name %></span>
              <span class="ui-money"><%= money(amount) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section id="expense-ledger" class="ui-card">
      <h2 class="font-semibold">This month</h2>
      <ul class="mt-3 grid gap-2">
        <% @expenses.each do |expense| %>
          <li class="flex items-baseline justify-between gap-3">
            <%= link_to "#{expense.spent_on} #{expense.kind}", expense, class: "ui-link" %>
            <span class="ui-money"><%= number_to_currency(expense.amount) %></span>
          </li>
        <% end %>
      </ul>
    </section>

    <section id="three-month-average" class="ui-card md:col-span-2">
      <h2 class="font-semibold">Three-month spending average</h2>
      <% if @baseline[:months].blank? %>
        <p class="mt-2 text-sm">Record expenses and the three-month average will appear here.</p>
      <% else %>
        <p class="mt-2 text-2xl font-semibold"><%= money(@baseline[:average]) %></p>
        <ul class="mt-3 grid gap-2">
          <% @baseline[:months].zip(@baseline[:totals]).each do |month, total| %>
            <li class="flex items-baseline justify-between gap-3">
              <span><%= month.strftime("%B %Y") %></span>
              <span class="ui-money"><%= money(total) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
<% end %>
<section id="expense-import" class="ui-card mt-4">
  <h2 class="font-semibold">Import</h2>
  <%= link_to "Import CSV", new_expense_import_path, class: "ui-button-secondary mt-3" %>
</section>
