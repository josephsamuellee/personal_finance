<div class="ui-card" data-empty-state="<%= local_assigns.fetch(:kind, "empty") %>">
  <h2 class="text-base font-semibold"><%= title %></h2>
  <p class="mt-1 text-sm"><%= message %></p>
  <% if local_assigns[:links] %>
    <div class="mt-3 flex flex-col items-start gap-2"><%= links %></div>
  <% end %>
</div>
