<!DOCTYPE html>
<html data-appearance="<%= appearance_mode %>">
  <head>
    <%= render "shared/appearance" %>
    <title><%= content_for(:title) || "Quick Expense" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="overflow-x-hidden bg-slate-50 font-sans text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <header class="flex items-center justify-between gap-3 border-b border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900">
      <%= link_to "Quick Expense", quick_expense_path, class: "ui-button" %>
      <%= link_to "Sign in", (User.none? ? "/users/new" : "/session/new"), class: "ui-button-secondary" %>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-4">
      <%= render "shared/flashes" %>
      <%= yield %>
    </main>
  </body>
</html>
