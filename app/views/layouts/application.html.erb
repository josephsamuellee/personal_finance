<!DOCTYPE html>
<html data-appearance="<%= appearance_mode %>">
  <head>
    <%= render "shared/appearance" %>
    <title><%= content_for(:title) || "Personal Finance" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="overflow-x-hidden bg-slate-50 font-sans text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="min-h-screen lg:flex">
      <aside class="hidden lg:flex lg:w-60 lg:flex-col lg:gap-2 lg:border-r lg:border-slate-200 lg:bg-white lg:p-4 dark:lg:border-slate-800 dark:lg:bg-slate-900">
        <p class="px-2 text-sm font-semibold">Personal Finance</p>
        <%= render "shared/navigation", variant: "sidebar" %>
        <% if current_user %>
          <%= link_to "Settings", settings_path, class: "ui-button-secondary mt-auto" %>
        <% end %>
      </aside>
      <div class="min-w-0 flex-1 pb-[calc(6.5rem+env(safe-area-inset-bottom))] lg:pb-8">
        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900">
          <%= link_to "Quick Expense", quick_expense_path, class: "ui-button" %>
          <div class="flex flex-wrap items-center gap-3">
            <p class="truncate text-sm text-slate-600 dark:text-slate-300"><%= current_user&.email_address %></p>
            <% if current_user %>
              <%= link_to "Settings", settings_path, class: "ui-button-secondary" %>
              <%= link_to "Add user", new_user_path, class: "ui-button-secondary" %>
              <%= button_to "Sign out", session_path, method: :delete, class: "ui-button-secondary", form: { data: { turbo_submits_with: "Signing out…" } } %>
            <% end %>
          </div>
        </header>
        <main class="mx-auto max-w-7xl px-4 py-4">
          <%= render "shared/flashes" %>
          <%= yield %>
        </main>
      </div>
    </div>
    <nav class="fixed inset-x-0 bottom-0 border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] lg:hidden dark:border-slate-800 dark:bg-slate-900" aria-label="Primary">
      <%= render "shared/navigation", variant: "bottom" %>
    </nav>
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/service-worker.js")
      }
    </script>
  </body>
</html>
