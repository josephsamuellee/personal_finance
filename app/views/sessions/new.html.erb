<h1 class="text-xl font-semibold">Sign in</h1>
<%= form_with url: session_path, class: "mt-4 grid max-w-sm gap-3" do |form| %>
  <%= form.label :email_address, "Email" %>
  <%= form.email_field :email_address, required: true %>
  <%= form.label :password %>
  <%= form.password_field :password, required: true %>
  <%= form.submit "Sign in" %>
<% end %>
<% if User.none? %>
  <p class="mt-4"><%= link_to "Create the first user", new_user_path, class: "ui-button-secondary" %></p>
<% end %>
