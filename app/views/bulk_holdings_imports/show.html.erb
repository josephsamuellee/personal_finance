<% content_for :title, "Bulk edit holdings" %>
<%= render "shared/page_header",
      title: "Bulk edit holdings",
      purpose: "Download every open holding, edit it in any spreadsheet, and upload it back as one snapshot.",
      primary: link_to("Back to Assets", assets_path, class: "ui-button-secondary") %>

<section class="ui-card mt-4 max-w-lg" aria-labelledby="bulk-rules">
  <h2 id="bulk-rules" class="font-semibold">Before you edit</h2>
  <ul class="mt-2 list-disc pl-5 text-sm">
    <li>The download lists every open holding in every active brokerage account as of today.</li>
    <li>An upload uses exactly one observation date for every row. Past dates are allowed; future dates are not. Dates are YYYY-MM-DD.</li>
    <li>Set quantity 0 to record a sale. A holding left out of the file is ignored for that date, not closed.</li>
    <li>Keep each row's account_id. account_name is a label to help you; if it differs, the row still saves to the account_id account.</li>
    <li>price_per_share is blank in the download. Fill it in, or leave it blank to reuse a saved price for that date. last_price is for reference and is ignored on upload.</li>
  </ul>
  <p class="mt-3"><%= link_to "Download all holdings CSV", export_bulk_holdings_import_path, class: "ui-button-secondary" %></p>
</section>

<section class="ui-card mt-4 max-w-lg" aria-labelledby="bulk-upload">
  <h2 id="bulk-upload" class="font-semibold">Upload edited CSV</h2>
  <%= render "upload_form", label: "Review upload" %>
</section>
