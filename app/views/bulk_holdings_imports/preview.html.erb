<% content_for :title, "Review bulk holdings" %>
<%= render "shared/page_header",
      title: "Review bulk holdings",
      purpose: "This is what the CSV says. Nothing is saved until you confirm." %>

<% snapshot_date = @planned.filter_map(&:observed_on).uniq.one? ? @planned.first.observed_on : nil %>
<% blocked = @planned.any? { |row| !row.valid? } %>

<section class="ui-card mt-4" data-section="bulk-holdings-review">
  <p class="text-sm">File: <%= @draft["filename"] %>. Date: <%= snapshot_date || "not one date" %>. <%= pluralize(@planned.size, "row") %>.</p>
  <ul class="mt-3 grid gap-3">
    <% @planned.each do |row| %>
      <% status = row.errors.any? ? :error : (row.warnings.any? ? :warning : :accepted) %>
      <li class="rounded-md border border-slate-200 p-3 dark:border-slate-700" data-row-status="<%= status %>">
        <p class="flex items-center gap-2 font-medium">
          <%= render "status_marker", status: %>
          Row <%= row.line %> · <%= row.account ? "#{row.account.name} (##{row.account.id})" : "No account" %> · <%= row.ticker %>
        </p>
        <p class="text-sm">Quantity <%= row.quantity %> · Cost basis <%= row.cost_basis %> · Price <%= row.price %></p>
        <p class="text-sm">Outcome: <%= row.outcomes.to_sentence.presence || "not planned" %></p>
        <% if row.previous_note.present? || row.note.present? %>
          <p class="text-sm">Shared note <%= row.previous_note.presence || "(none)" %> → <%= row.note.presence || "(unchanged)" %></p>
        <% end %>
        <% if row.price_conflict? %>
          <p class="text-sm">Saved price <%= row.saved_price %> would become <%= row.price %> for every account holding <%= row.ticker %>.</p>
        <% end %>
        <% (row.errors + row.warnings).each do |message| %>
          <p class="text-sm text-red-700 dark:text-red-300"><%= message %></p>
        <% end %>
      </li>
    <% end %>
    <% @missing.each do |holding| %>
      <li class="rounded-md border border-slate-200 p-3 dark:border-slate-700" data-row-status="warning">
        <p class="flex items-center gap-2 font-medium">
          <%= render "status_marker", status: :warning %>
          Not in file · <%= holding.account.name %> (#<%= holding.account.id %>) · <%= holding.security.ticker %>
        </p>
        <p class="text-sm text-red-700 dark:text-red-300">This holding is ignored; no observation will be saved for it<%= " on #{snapshot_date}" if snapshot_date %>. To record a sale, upload it with quantity 0.</p>
      </li>
    <% end %>
  </ul>
</section>

<section class="ui-card mt-4" aria-labelledby="bulk-decide">
  <h2 id="bulk-decide" class="font-semibold">What next?</h2>
  <%= form_with url: confirm_bulk_holdings_import_path, class: "mt-3 grid gap-3" do %>
    <%= hidden_field_tag :fingerprint, @fingerprint %>
    <% @planned.select(&:price_conflict?).each do |row| %>
      <label class="flex min-h-11 items-center gap-2 text-sm">
        <input type="checkbox" name="authorize_price[]" value="<%= row.price_key %>">
        Replace <%= row.ticker %> <%= row.observed_on %> price <%= row.saved_price %> with <%= row.price %>
      </label>
    <% end %>
    <% if snapshot_date && snapshot_date < Date.current %>
      <div class="rounded-md border border-amber-400 bg-amber-50 p-3 dark:border-amber-600 dark:bg-amber-950" role="alert">
        <label class="flex min-h-11 items-center gap-2 text-sm">
          <input type="checkbox" name="historical_ack" value="1">
          I intend to record a historical snapshot for <%= snapshot_date %>
        </label>
      </div>
    <% end %>
    <% if blocked %>
      <p class="text-sm text-red-700 dark:text-red-300">Fix the errors in your CSV and upload it again to continue.</p>
    <% end %>
    <button class="ui-button" type="submit" data-turbo-submits-with="Importing…" <%= "disabled" if blocked %>>Confirm import</button>
  <% end %>
  <h3 class="mt-4 text-sm font-medium">Upload a corrected CSV</h3>
  <%= render "upload_form", label: "Upload corrected CSV" %>
  <%= button_to "Cancel", cancel_bulk_holdings_import_path, method: :delete, class: "ui-button-secondary mt-3" %>
</section>
